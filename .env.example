# ---------------------------------------------------------------------------
# OrderFlow - environment variable placeholders.
#
# Copy to .env for local development. NEVER commit real values.
# Set these in Vercel -> Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# SERVER-ONLY. Bypasses Row Level Security. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# --- Paystack -----------------------------------------------------------------
PAYSTACK_SECRET_KEY=<PAYSTACK_SECRET_KEY>
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=<PAYSTACK_PUBLIC_KEY>

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
